; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="anthurium"
run/main_scene="uid://b5tywkohv6dpv"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=144
boot_splash/show_image=false
config/icon="uid://fxx3rmr4qv7e"

[audio]

buses/default_bus_layout="uid://c5uthsyh468rh"

[autoload]

EntityRegistry="*uid://jodfnnuxww7"
AccessoryArchetypeRegistry="*uid://c63420q4iw3af"
BloomEventRegistry="*uid://bd62gkjf4xwo8"
CellTypeRegistry="*uid://d2ofrmjgk1kn4"
Log="*uid://cqm0vj5x7nq6h"
AppController="*uid://0vmrob7f8ql5"
BFXR="*uid://ii1c8s5men3x"
EventBus="*uid://b8owa3ug0hg2r"
WorldGrid="*uid://bwg7qqpbsymol"
EntityManager="*uid://da7h718q207u5"
PlayerManager="*uid://bsea5f0xq6js7"
ParticleManager="*uid://dysb6b5wli0hs"
CameraController="*uid://rrfxfwvhpqup"
AudioManager="*uid://uiuetvnukvsw"
TerrainManager="*uid://poanoxh62038"
UiController="*uid://pmgi17orx2e7"
GameInterface="*uid://d4myfbotj4m52"
AnthuriumInterface="*uid://bqqf3kkn3ad37"
MusicController="*uid://s3f234v7vm1e"
RunRng="*uid://dtogeyftd4ovl"
CollisionResolutionTracker="*uid://dauakwttssnwo"
DebugOverlay="*uid://bjcltnmlky4ve"
DeviceManager="*uid://bokfjyxh26vgt"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/size/initial_position_type=3

[dotnet]

project/assembly_name="anthurium"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/min_max_range/plugin.cfg", "res://addons/quick_add_palette/plugin.cfg", "res://addons/tile_copy/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/resources/": "red",
"res://assets/sounds/": "green",
"res://assets/textures/": "blue",
"res://scenes/entities/": "red",
"res://scenes/systems/": "green",
"res://scenes/title_screen/": "blue",
"res://scripts/abilities/": "red",
"res://scripts/autoload/": "orange",
"res://scripts/brain/states/": "purple",
"res://scripts/classes/": "yellow",
"res://scripts/components/": "green",
"res://scripts/lobes/": "teal",
"res://scripts/resources/": "blue",
"res://scripts/ui/": "pink",
"res://scripts/wave/": "blue"
}

[global_group]

orb=""
creature=""


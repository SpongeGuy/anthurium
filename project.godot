[layer_names]

2d_physics/layer_1="unclearable_wall"
2d_navigation/layer_1="ground"
2d_physics/layer_2="creatures"
2d_navigation/layer_2="underground"
2d_physics/layer_3="items"
2d_navigation/layer_3="sky"
2d_physics/layer_4="projectiles"
2d_navigation/layer_4="aquatic"
2d_physics/layer_5="plants"
2d_physics/layer_6="proximity"
2d_physics/layer_7="hitbox"
2d_physics/layer_8="hurtbox"
2d_physics/layer_9="clearable_wall"
2d_physics/layer_13="hitbox_flying"
2d_physics/layer_14="hurtbox_flying"
2d_physics/layer_15="hitbox_ground"
2d_physics/layer_16="hurtbox_ground"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
2d/stretch/mode="viewport"
2d/size/mode=3
2d/size/viewport_height=360
2d/size/viewport_width=640

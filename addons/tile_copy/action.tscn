[gd_scene format=3 uid="uid://cxasq8wcxx21c"]

[sub_resource type="GDScript" id="GDScript_gv1iu"]
script/source = "@tool
extends Button
@onready var source_terrain_input: SpinBox = $\"../SourceTerrain/SourceTerrainInput\"
@onready var target_terrain_input: SpinBox = $\"../TargetTerrain/TargetTerrainInput\"

func update_disabled(value: float) -> void:
	disabled = source_terrain_input.value == target_terrain_input.value
"

